{
  "name": "beyours",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check:accents": "node scripts/check-french-accents.mjs",
    "check:attribution": "node scripts/check-commit-attribution.mjs",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "check:divergence": "node scripts/check-app-divergence.mjs",
    "check:mirror-css": "node scripts/check-mirror-css.mjs",
    "check:pending-release": "node scripts/check-pending-release.mjs",
    "check:pr-attribution": "node scripts/check-pr-attribution.mjs",
    "check:release-hold": "node scripts/check-release-hold.mjs",
    "check:source-drift": "node scripts/check-source-drift.mjs",
    "check:mirror-build": "node scripts/check-mirror-build.mjs",
    "check:mirror-ci": "node scripts/check-mirror-ci.mjs",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "pnpm --filter @beyours/reference test:ui",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "pnpm --filter @beyours/reference test:e2e:ui",
    "test:e2e:debug": "pnpm --filter @beyours/reference test:e2e:debug",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node scripts/check-release-hold.mjs && turbo run build && changeset publish",
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev:site": "pnpm --filter @beyours/site dev",
    "dev:reference": "pnpm --filter @beyours/reference dev",
    "dev:themes": "pnpm --filter @beyours/themes dev",
    "env:check": "node scripts/infisical-bootstrap.mjs check",
    "env:plan": "node scripts/infisical-bootstrap.mjs plan",
    "env:seed": "node scripts/infisical-bootstrap.mjs seed",
    "dev:site:env": "node scripts/infisical-bootstrap.mjs run --scope=site -- pnpm dev:site",
    "dev:reference:env": "node scripts/infisical-bootstrap.mjs run --scope=reference -- pnpm dev:reference",
    "dev:themes:env": "node scripts/infisical-bootstrap.mjs run --scope=themes -- pnpm dev:themes",
    "dev:demo:env": "node scripts/infisical-bootstrap.mjs run --scope=demo -- pnpm dev:themes"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "eslint": "^9.39.4",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "picomatch@<2.3.2": "^2.3.2",
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "eslint-plugin-react-hooks": "7.0.1",
      "hono@<4.12.34": "^4.12.34",
      "dompurify@<3.4.13": "^3.4.13",
      "fast-uri@<3.1.6": "^3.1.6",
      "undici@<7.29.0": "^7.29.0",
      "postcss@<8.5.23": "^8.5.23",
      "ip-address@<10.3.1": "^10.3.1",
      "nanoid@<3.3.18": "^3.3.18",
      "@hono/node-server@<1.19.15": "^1.19.15",
      "kysely@<0.28.17": "^0.28.17",
      "linkify-it@<5.0.2": "^5.0.2",
      "fast-xml-parser@<5.7.0": "^5.11.0",
      "fast-xml-builder@<1.1.7": "^1.1.9",
      "qs@<6.15.2": "^6.15.2",
      "body-parser@<2.3.0": "^2.3.0",
      "@babel/core@<7.29.6": "^7.29.6",
      "sharp@<0.35.0": "^0.35.4",
      "brace-expansion@>=3.0.0 <5.0.9": "^5.0.9",
      "browserslist@<4.28.7": "^4.28.7",
      "next@<16.3.3": "^16.3.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-qq9h-g4jm-xgf3"
      ]
    }
  }
}
