supportedArchitectures:
  os:
    - current
    - linux
  cpu:
    - current
    - arm64

# GitHub Packages for the @be-yours scope. The scope must be the owning org's
# login exactly — that is GitHub Packages' rule — and the org is `be-yours`.
# Reads need NODE_AUTH_TOKEN with `read:packages` on that org; a token scoped to
# `be-in-digital`, which held the packages before the rename, will 401 here.
@be-yours:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
