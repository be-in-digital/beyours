{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // Turbo strips undeclared variables from a task's environment.
      // NEXT_PUBLIC_* reaches the Next builds through framework inference;
      // these three do not, and withSentryConfig reads them at build time to
      // upload source maps. Declaring them also puts them in the cache key, so
      // a build made without an auth token is not reused for one made with it.
      //
      // CONVEX_SITE_URL is here for a different reason than the other three:
      // nothing in a build reads it today, but `.github/workflows/ci.yml` pins
      // it on the Build step — deliberately, to keep a real backend URL out of
      // a compile-check bundle — and that line was inert, because an undeclared
      // variable never crosses this boundary. Declaring it makes the pin real
      // rather than decorative, and makes the day something does read it a
      // non-event.
      "env": ["SENTRY_ORG", "SENTRY_PROJECT", "SENTRY_AUTH_TOKEN", "CONVEX_SITE_URL"],
      "passThroughEnv": ["CI"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // No `env` on lint or type-check on purpose, and this comment is the
    // answer to the next person who notices the asymmetry with `build` and
    // `test`. ESLint and tsc read no project variable: measured by scanning
    // every config and plugin in the repo for `process.env`, and the three
    // repository checks folded into the Lint job (`check:accents`,
    // `check:divergence`, `check:mirror-css`) are separate steps in ci.yml that
    // never travel through turbo. `CI` reaches every task regardless — turbo
    // treats it as a system variable, which was measured rather than assumed.
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      // `env`, not `passThroughEnv`, and the difference is the whole point.
      //
      // With `globalEnvMode` at its default of `strict`, an undeclared variable
      // is stripped before vitest starts — so the three Deliveroo suites that
      // self-skip on `it.runIf(hasWebhookTarget)` / `hasDeliverooSandbox`
      // (`scenario-02`, `scenario-08`, `menu/scenario-01`, in each of the two
      // apps) skipped no matter what was set in the repository secrets. Setting
      // a GitHub secret could not make a gated suite run, which is a worse
      // failure than the suite being off: the secret exists, it looks
      // load-bearing, and the run is green either way.
      //
      // `tasks/ci-required-checks-runbook.md` §7 calls it "the 11 Deliveroo
      // suites". Counted: twelve files under `apps/*/e2e/deliveroo`, three of
      // which gate on credentials. The other nine assert on signatures and
      // mappings offline and always ran.
      //
      // `passThroughEnv` would have let the value through and left the second
      // half open. This task is CACHED (`outputs: coverage/**`), and a
      // passed-through variable is not part of the cache key — so the first run
      // after a secret appeared would have replayed the cached result of the run
      // that skipped everything. In `env` the value is in the key: turning a
      // secret on changes the hash, the suite genuinely re-runs, and the skip
      // becomes a pass or a failure.
      //
      // `apps/reference/__tests__/turbo-test-env.test.ts` holds this list to
      // what the suites actually read. Adding `process.env.SOMETHING` to a test
      // without adding it here fails that guard rather than silently reading
      // undefined.
      "env": [
        // The Deliveroo scenario suites under `apps/*/e2e/deliveroo` — Vitest,
        // not Playwright, and the reason this task needed fixing at all.
        "CONVEX_SITE_URL",
        "DELIVEROO_CLIENT_ID",
        "DELIVEROO_CLIENT_SECRET",
        "DELIVEROO_WEBHOOK_SECRET",
        "DELIVEROO_SITE_ID",
        "DELIVEROO_BRAND_ID",
        "DELIVEROO_E2E_REQUIRE_LIVE",
        "DELIVEROO_IS_SANDBOX",
        "SEED_ADMIN_EMAIL",
        "SEED_PASSWORD",
        // Uber Eats and the payment providers: sandbox flags and the webhook
        // secrets the signature suites verify against.
        "UBER_EATS_CLIENT_ID",
        "UBER_EATS_CLIENT_SECRET",
        "UBER_EATS_WEBHOOK_SECRET",
        "UBER_EATS_SANDBOX_MODE",
        "PAYPAL_SANDBOX_MODE",
        "STRIPE_WEBHOOK_SECRET",
        "STRIPE_CONNECT_WEBHOOK_SECRET",
        // AWS, read by the S3 and SES suites.
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_S3_BUCKET_NAME",
        "AWS_SES_CONFIGURATION_SET",
        // The rest.
        "ADMIN_BOOTSTRAP_TOKEN",
        "OPENAI_API_KEY",
        // NEXT_PUBLIC_* already crosses the boundary — turbo passes the prefix
        // through unconditionally, measured. They are named anyway so they
        // belong to the CACHE KEY: a suite run against one VAT stance must not
        // be replayed for another.
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_TVA_ENABLED"
      ],
      "passThroughEnv": ["CI"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      // The e2e job is the one task whose command spawns a *server*, and strict
      // mode strips everything below before Playwright ever starts it.
      //
      // `.github/workflows/e2e.yml` sets all of these in the job environment,
      // and CI calls `pnpm test:e2e` from the root — so they travel through
      // turbo, which dropped them. `next start` then failed its own env check
      // ("10 environment variable(s) missing or invalid"), the web server never
      // came up, and the run died on the 120 s webServer timeout with zero
      // tests executed. Every local run went through `cd apps/reference`
      // instead, which is why nothing ever caught it.
      //
      // passThroughEnv, not env: this task is uncached, so there is no key for
      // these to belong to.
      "passThroughEnv": [
        "CI",
        "E2E_USE_BUILD",
        // The suite: which account to sign in as, and with what password.
        "SEED_ADMIN_EMAIL",
        "SEED_PASSWORD",
        // The required tier of `packages/core/src/env/schemas.ts`, which
        // instrumentation.ts enforces at startup and refuses to serve without.
        "NEXT_PUBLIC_CONVEX_URL",
        "CONVEX_SITE_URL",
        "CONVEX_DEPLOYMENT",
        "SITE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "ENCRYPTION_KEY",
        "AWS_S3_BUCKET_NAME",
        "AWS_SES_FROM_EMAIL",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "OPENAI_API_KEY",
        // Read by the Deliveroo suites, which skip themselves when unset.
        "DELIVEROO_CLIENT_ID",
        "DELIVEROO_CLIENT_SECRET",
        "DELIVEROO_WEBHOOK_SECRET",
        "DELIVEROO_SITE_ID",
        "DELIVEROO_BRAND_ID"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
