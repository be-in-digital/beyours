# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright / E2E (reports, results, browser auth state — must never be committed)
playwright-report/
test-results/
blob-report/
playwright/.cache/
**/e2e/.auth/
.playwright-mcp/

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# IDE
.idea/

# Claude Code
.claude/
.mcp.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secret-rotation working files (git-filter-repo replace-text — never commit)
secrets-to-redact.txt

# env files (can opt-in for committing if needed)
.env*
# ...but example templates MUST be committed (no secrets, placeholders only)
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo

# Package build output
dist/

# Sentry
.sentryclirc

# Convex
/convex/
.convex-build/

# Changesets
# .changeset/*.md files must be committed for changesets to work
.gstack/
