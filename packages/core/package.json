{
  "name": "@be-in-digital/core",
  "version": "3.0.0",
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/be-in-digital/beyours.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "import": "./dist/env/index.mjs",
      "require": "./dist/env/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.mjs",
      "require": "./dist/email/index.js"
    },
    "./sentry": {
      "types": "./dist/sentry/index.d.ts",
      "import": "./dist/sentry/index.mjs",
      "require": "./dist/sentry/index.js"
    },
    "./allergens": "./src/allergens/index.ts",
    "./status-labels": "./src/i18n/status-labels.ts",
    "./dining": "./src/dining/table-number.ts",
    "./auth/rbac": "./src/auth/rbac.ts",
    "./aws/ses/order-confirmation": "./src/aws/ses/order-confirmation.ts",
    "./aws/media-url": "./src/aws/media-url.ts",
    "./aws/folders": "./src/aws/folders.ts",
    "./email/providers": "./src/email/providers.ts"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1024.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
