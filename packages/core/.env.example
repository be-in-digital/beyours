# =============================================================================
# BeYours platform-level credentials (packages/core)
# =============================================================================
# These belong to BeYours's shared infrastructure (AWS, OpenAI) and the
# partner apps registered with Uber Eats / Deliveroo. They are the SAME across
# all restaurant deployments and are injected via the platform's secret store
# (GitHub Secrets / Convex env / Vercel env), never committed.
#
# Schema: packages/core/src/env/schemas.ts → packageEnvSchema
# =============================================================================

# --- AWS (BeYours account) -----------------------------------------------
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OpenAI (BeYours pays for GPT translations) --------------------------
OPENAI_API_KEY=sk-...

# --- Uber Eats partner app ---------------------------------------------------
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Optional. If unset, Uber Eats webhook verification uses the client secret.
UBER_EATS_WEBHOOK_SECRET=

# --- Uber Direct (delivery-as-a-service) -------------------------------------
# Rides on the Uber Eats app credentials above. Optional dedicated webhook
# signing secret: if unset, convex/uberDirectWebhook.ts falls back to
# UBER_EATS_WEBHOOK_SECRET, then to UBER_EATS_CLIENT_SECRET.
UBER_DIRECT_WEBHOOK_SECRET=

# --- Deliveroo partner app ---------------------------------------------------
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
