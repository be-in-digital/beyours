# ─────────────────────────────────────────────────────────────────────────────
# web-restaurant — Variables d'env de PRODUCTION (exemple documenté, sans secret)
# ─────────────────────────────────────────────────────────────────────────────
#
# ⚠️  À LIRE AVANT TOUTE BASCULE D'ENV EN PROD  ⚠️
#
# Les variables NEXT_PUBLIC_* sont INLINÉES dans le bundle JS au moment du
# `next build` : leurs valeurs finissent EN DUR dans les chunks servis au
# navigateur. Conséquence (bug #6, juil. 2026) : le bundle Vercel de prod
# pointait encore vers une URL Convex MORTE (happy-otter-123) alors que la
# variable Vercel avait bien été changée — parce qu'un simple *redeploy*
# réutilise le cache de build et NE RÉ-INLINE PAS les nouvelles valeurs.
#
#   → Après CHAQUE changement d'une NEXT_PUBLIC_* sur Vercel :
#     REBUILD SANS CACHE (Vercel « Redeploy » en DÉCOCHANT
#     « Use existing Build Cache »). Un redeploy simple NE SUFFIT PAS.
#   → Puis vérifier le bundle réellement servi :
#     node scripts/check-prod-bundle.mjs https://restaurant.beindigital.fr
#
# Ce fichier ne contient AUCUN secret : les NEXT_PUBLIC_* sont publiques par
# nature (lisibles dans le navigateur). Les secrets (Stripe, AWS SES, Resend…)
# vivent CÔTÉ SERVEUR — env du déploiement Convex de prod + env serveur Vercel,
# JAMAIS en NEXT_PUBLIC_*. Voir MISE_EN_PROD.md §7.
#
# Déploiement Convex de PROD = fearless-poodle-133
#   (team momoseck8 / projet wedilybird). Toute autre URL *.convex.cloud dans le
#   bundle = ERREUR. En particulier : happy-otter-123 (MORT), et les
#   déploiements de DEV (ex. capable-crocodile-720) ne partent JAMAIS en prod.
# ─────────────────────────────────────────────────────────────────────────────

# Backend Convex (queries/mutations temps réel). URL .convex.cloud du
# déploiement de PROD. C'est LA variable qui a causé le bug #6.
NEXT_PUBLIC_CONVEX_URL=https://fearless-poodle-133.convex.cloud

# HTTP actions Convex Auth (endpoints .convex.site du MÊME déploiement).
# Doit rester APPARIÉE à NEXT_PUBLIC_CONVEX_URL (même sous-domaine).
NEXT_PUBLIC_CONVEX_SITE_URL=https://fearless-poodle-133.convex.site

# URL publique canonique du site (liens absolus SEO + logo dans les emails).
# Base de lib/site-config.ts et des emails transactionnels (convex/email).
NEXT_PUBLIC_SITE_URL=https://restaurant.beindigital.fr

# TVA côté vitrine/checkout. Laisser `false` tant que la structure est en
# franchise en base (art. 293 B du CGI). Le jour de l'assujettissement : passer
# à `true` ICI **ET** STRIPE_TAX_ENABLED=true côté Convex (les deux vont
# ensemble — cf. convex/stripe.ts & lib/payment-providers.ts). Absente ⇒ false.
NEXT_PUBLIC_TVA_ENABLED=false
