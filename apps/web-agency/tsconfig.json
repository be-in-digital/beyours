{
  "extends": "@beindigital/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@beindigital/tokens": ["../../packages/tokens"],
      "@beindigital/tokens/*": ["../../packages/tokens/*"],
      "@beindigital/webgl-utils": ["../../packages/webgl-utils/src"],
      "@beindigital/webgl-utils/*": ["../../packages/webgl-utils/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
