# ──────────────────────────────────────────────
# Be in Digital — Agency
# Variables d'environnement (.env.local non versionné)
# ──────────────────────────────────────────────

# Convex agence (déploiement SÉPARÉ du resto — Decision Log #13)
# Généré par `npx convex dev` à la première init.
# Le client (Convex provider + Convex Auth) lit NEXT_PUBLIC_CONVEX_URL.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL_AGENCY=

# ── Back-office / Auth (Convex Auth, provider Password) ──
# URL publique du site, utilisée par le flux d'auth (redirections).
# Local : http://localhost:3001 — Prod : https://beindigital.fr
# NB : SITE_URL + les clés JWT (JWKS / JWT_PRIVATE_KEY) sont posées SUR le
# déploiement Convex par `npx @convex-dev/auth` — rien à mettre ici pour elles.
SITE_URL=http://localhost:3001

# Vercel BotID (anti-spam form contact — Decision Log #27)
# https://vercel.com/docs/botid
VERCEL_BOTID_SECRET=

# Optionnel — analytics anonymisé (exempté CNIL si pas d'identifiant utilisateur)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
