# ──────────────────────────────────────────────
# Be in Digital — Agency
# Variables d'environnement (.env.local non versionné)
# ──────────────────────────────────────────────

# Convex agence (déploiement SÉPARÉ du resto — Decision Log #13)
# Généré par `pnpm dlx convex dev` à la première init
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL_AGENCY=

# Vercel BotID (anti-spam form contact — Decision Log #27)
# https://vercel.com/docs/botid
VERCEL_BOTID_SECRET=

# Optionnel — analytics anonymisé (exempté CNIL si pas d'identifiant utilisateur)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
