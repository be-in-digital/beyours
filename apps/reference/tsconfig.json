{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `tests/` holds convex-test suites that rely on Vite's `import.meta.glob`
  // and the harness's own generics — same arrangement as apps/site.
  "exclude": ["node_modules", "convex", "tests"]
}
