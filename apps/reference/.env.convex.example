# ===========================================================================
# CONVEX-side environment variables (backend functions)
# ---------------------------------------------------------------------------
# The Convex deployment carries its OWN environment store. It is not the one
# Next.js reads, and nothing in `.env.local` reaches it: a variable set for the
# web app is invisible to every action under `convex/`.
#
# This file exists because that gap has bitten twice. `apps/themes` shipped a
# Convex template and `apps/reference` did not, while the integrations that
# read these variables — Uber Eats, Deliveroo, PayPal — run almost entirely on
# the Convex side.
#
# Copy to `.env.convex` (gitignored — NEVER commit it), fill in only the
# integrations this bench actually exercises, then push:
#
#   npx convex env set NAME value          # one at a time
#   npx convex env list                    # read back what the deployment has
#
# There is no bulk `pnpm convex:env` here — that script lives in `apps/themes`.
# To apply the whole file at once:
#
#   grep -v '^\s*#' .env.convex | grep '=' | while IFS='=' read -r k v; do \
#     [ -n "$v" ] && npx convex env set "$k" "$v"; done
#
# `validateAllEnv()` runs in `instrumentation.ts`, i.e. on the NEXT.JS side.
# It cannot see this store. Convex-side reads stay permissive by design: a
# missing variable does not block the deploy, it fails the action at the moment
# a customer uses it. Hence the "without it: …" note on each line.
# ===========================================================================

# --- Error reporting (Sentry) ----------------------------------------------
# The DSN of THIS CLIENT's Sentry project — the same one the Next.js half uses.
# One project per client: a restaurant's errors, its quota and its retention
# belong to it and follow it if it leaves.
#
# `SENTRY_DSN`, not `NEXT_PUBLIC_SENTRY_DSN`. The prefix means "inlined into a
# browser bundle", and this store is never read by Next.js — naming it that way
# here is how an operator ends up setting the one that does nothing. The old
# name still works as a fallback.
#
# Without it: backend errors go to `console.error` only, i.e. to this
# deployment's dashboard and nowhere else. That is a supported state and costs
# nothing — no transport is created — but it is also the state in which a
# Saturday-night webhook failure is seen by no one.
#
# See apps/docs/deployment/sentry.md
SENTRY_DSN=

# Which environment the events belong to: production | preview | development.
# Without it: derived from NODE_ENV, which a Convex deployment reports as
# "production" for a preview backend too — so a preview's errors would raise
# issues against the client's production.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Auth ------------------------------------------------------------------
# At least 32 characters — openssl rand -base64 32
# Without it: sessions cannot be signed, and a password reset returns early
# without ever sending the mail.
BETTER_AUTH_SECRET=

# Dedicated credential for POST /api/email/send, separating the mail relay from
# the session-signing key. Set it on BOTH the Next.js env AND the Convex
# deployment: the route authenticates with it and convex/auth.ts presents it.
# Unset, both sides fall back to BETTER_AUTH_SECRET (transitional).
# At least 32 characters — openssl rand -base64 32
EMAIL_API_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# CONVEX_SITE_URL: do NOT put it here. Convex provides it itself and the API
# refuses to let it be overridden ("EnvVarNameForbidden: … is built-in and
# cannot be overridden"). It is still needed on the Next.js side (.env.local),
# where nothing supplies it.

# --- Admin / return URLs ---------------------------------------------------
# Origin of the admin app, used for the post-OAuth redirects.
# Without it: production sends the operator back to http://localhost:3000.
ADMIN_URL=http://localhost:3000
# Fallback for team-invitation links when SITE_URL is absent.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Claims the FIRST super-admin seat on a fresh deployment. Fails CLOSED: unset,
# claimFirstAdmin refuses everyone and nobody can take the back office.
# Generate: openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=
# Relaxes Better Auth's email verification (convex/auth.ts). Fails CLOSED: only
# the exact value "true" changes anything. TEST deployments only — never on one
# that serves a restaurant.
AUTH_ALLOW_UNVERIFIED_EMAIL=false

# --- Encryption (OAuth tokens at rest) — openssl rand -hex 32 --------------
ENCRYPTION_KEY=

# --- AWS (S3 uploads + SES email) ------------------------------------------
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
# Public base for media links (CDN in front of the bucket). Unset, media is
# served through the app's own /api/files proxy.
AWS_S3_PUBLIC_BASE_URL=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=

# --- OpenAI (automatic translation) ----------------------------------------
OPENAI_API_KEY=

# --- Stripe (restaurant payments) ------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal ----------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# REQUIRED as soon as the two ids above are set: the deployment refuses to boot
# without it. "true" = sandbox host, "false" = live host. Missing here anyway —
# and the Convex store runs no boot check of its own — it resolves to SANDBOX,
# never silently to production. convex/paypal.ts reads it from THIS store: this
# file decides which PayPal host actually settles an order.
PAYPAL_SANDBOX_MODE=true

# --- SumUp -----------------------------------------------------------------
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# --- Uber Eats -------------------------------------------------------------
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Optional dedicated webhook signing secret. Unset, the client secret is used.
UBER_EATS_WEBHOOK_SECRET=
# REQUIRED as soon as the credentials above are set: the deployment refuses to
# boot without it. "true" = sandbox, "false" = live. Missing here anyway, it
# resolves to SANDBOX — never silently to production. Every Uber Eats read
# lives under convex/, so this store is the one that decides.
UBER_EATS_SANDBOX_MODE=true

# --- Uber Direct (on-demand delivery) --------------------------------------
# Dedicated signing secret, optional: failing that, uberDirectWebhook.ts falls
# back to UBER_EATS_WEBHOOK_SECRET, then to UBER_EATS_CLIENT_SECRET. With none
# of the three: the webhook answers 503 and courier tracking stops.
UBER_DIRECT_WEBHOOK_SECRET=

# --- Deliveroo -------------------------------------------------------------
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
# e2e fixtures. A live deployment reads these off its stored connection, so
# they are deliberately not required and do not switch the integration on.
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
# REQUIRED as soon as the credentials above are set: the deployment refuses to
# boot without it. "true" = sandbox, "false" = live. Missing here anyway, it
# resolves to SANDBOX — never silently to production.
DELIVEROO_IS_SANDBOX=true

# --- Unsplash (CMS media) --------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --- BeYours billing (Stripe BID) ------------------------------------------
# What BeYours charges the restaurant owner (maintenance renewal). These
# actions run here, on Convex: they have no Vercel-side equivalent. The first
# three go together (all or nothing).
# Without it: bidSubscription.ts throws "STRIPE_BID_SECRET_KEY non configure".
STRIPE_BID_SECRET_KEY=
# Without it: the renewal webhook is refused and a collected subscription is
# never recorded.
STRIPE_BID_WEBHOOK_SECRET=
# Absolute app URL, for checkout redirects and customer-email links.
BID_APP_URL=http://localhost:3000
# Stripe price of the annual renewal. Without it, "Renew online" is refused and
# the owner is sent back to BeYours.
STRIPE_BID_PRICE_MAINTENANCE=
# The six Auto Blog plan prices (article writing + image analysis), monthly and
# annual. convex/bidSubscription.ts reads all six: at checkout to turn a plan
# into a price, and at the webhook to turn a price back into a plan. Without
# them checkout throws "STRIPE_BID_PRICE_<PLAN> non configure", and a collected
# subscription maps to no plan at all.
#
# They were in no example file until 07/09/2026, so the paid Auto Blog tier
# could not be provisioned by following the documentation. Set all six or none:
# one missing breaks only its own plan, silently.
STRIPE_BID_PRICE_STARTER=
STRIPE_BID_PRICE_PRO=
STRIPE_BID_PRICE_ENTERPRISE=
STRIPE_BID_PRICE_STARTER_ANNUAL=
STRIPE_BID_PRICE_PRO_ANNUAL=
STRIPE_BID_PRICE_ENTERPRISE_ANNUAL=
# Address alerted over SES when a client asks to migrate their site. Without
# it, maintenanceEmail.ts logs and moves on: the request reaches nobody.
BID_NOTIFY_EMAIL=
