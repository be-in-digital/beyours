{
  "extends": "@beindigital/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2017",
    "noUncheckedIndexedAccess": false,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", ".claude/skills", "tests"]
}
