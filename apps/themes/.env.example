# =============================================================================
# BeYours Restaurant — environment template
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#   cp .env.example .env.local        (fait automatiquement par `pnpm setup`)
#
# Validation lives in @be-in-digital/core src/env/schemas.ts (Zod). Empty optional
# values are treated as "unset". Secrets must come from here / GitHub Secrets,
# never hardcoded in source.
# =============================================================================

# --- Convex (per restaurant) -------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Client-side twin of CONVEX_SITE_URL. Must stay paired with
# NEXT_PUBLIC_CONVEX_URL (same subdomain).
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_SITE_URL=https://your-deployment.convex.site
CONVEX_DEPLOYMENT=dev:your-deployment

# --- Auth (Better Auth) ------------------------------------------------------
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin app origin used for OAuth callback redirects (Uber Eats connect, etc.)
ADMIN_URL=http://localhost:3000

# Secret required to claim the FIRST super-admin seat on a fresh deployment.
# Set it on the CONVEX deployment (not just here), hand it to whoever sets the
# restaurant up, and drop it once the seat is taken.
# Sign-up is open on the storefront, so without this the first authenticated
# visitor could take the whole deployment. Leaving it unset refuses everyone —
# deliberately: it must never fail open.
# Generate: openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=

# --- Encryption (OAuth tokens at rest) ---------------------------------------
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# --- AWS S3 (per-restaurant bucket) ------------------------------------------
AWS_S3_BUCKET_NAME=
# Public base URL used to build asset links (CDN or public bucket URL).
AWS_S3_PUBLIC_BASE_URL=

# --- AWS SES (per-restaurant sending) ----------------------------------------
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=
AWS_SES_REPLY_TO_EMAIL=
AWS_SES_CONFIGURATION_SET=

# --- Monitoring / Maps (per client) ------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Payments (per restaurant) -----------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# IMPORTANT: when UNSET this defaults to PRODUCTION. Keep "true" for sandbox.
PAYPAL_SANDBOX_MODE=true
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=

# --- CMS media ---------------------------------------------------------------
UNSPLASH_ACCESS_KEY=

# --- Contact -----------------------------------------------------------------
# Public contact address surfaced in the app.
CONTACT_EMAIL=

# =============================================================================
# BeYours platform credentials (shared infra — see packages/core/.env.example)
# For LOCAL dev the app process reads these from this file too.
# =============================================================================

# --- AWS (BeYours account) -----------------------------------------------
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- OpenAI (translations) ---------------------------------------------------
OPENAI_API_KEY=sk-...

# --- BeYours billing (Stripe BID) --------------------------------------------
# Subscriptions billed BY BeYours TO the restaurant owner (autoBlog plans,
# annual maintenance renewal). Set these on the CONVEX deployment
# (`pnpx convex env set ...`) — the webhook and checkout actions run there.
STRIPE_BID_SECRET_KEY=sk_test_...
STRIPE_BID_WEBHOOK_SECRET=whsec_...
# Absolute URL of the deployed app, used for checkout redirect URLs
BID_APP_URL=http://localhost:3000

# --- Uber Eats (BeYours partner app) -------------------------------------
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Optional dedicated webhook signing secret. If unset, the client secret is used
# (Uber Eats signs webhooks with the client secret).
UBER_EATS_WEBHOOK_SECRET=
# IMPORTANT: when UNSET this defaults to PRODUCTION. Keep "true" for sandbox.
UBER_EATS_SANDBOX_MODE=true

# --- Deliveroo (BeYours partner app) -------------------------------------
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
DELIVEROO_BRAND_ID=
DELIVEROO_SITE_ID=
# IMPORTANT: when UNSET this defaults to PRODUCTION. Keep "true" for sandbox.
DELIVEROO_IS_SANDBOX=true

# =============================================================================
# Local dev / tooling (not used in production)
# =============================================================================
# Password for `tsx scripts/seed-users.mts` test accounts. Test only.
SEED_PASSWORD=
# Enables the /(test) routes. Keep unset/false outside local dev.
NEXT_PUBLIC_ENABLE_TEST_ROUTES=false
# Path to a local engine checkout, used by `pnpm engine:link` and the
# site-creation scripts.
BID_ENGINE_PATH=
# GitHub Packages PAT (read:packages) required by `pnpm install` for the
# private @be-in-digital/* packages. Prefer your shell env / .npmrc over
# storing it here.
NODE_AUTH_TOKEN=
# Set to "true" to skip the NODE_AUTH_TOKEN preflight check in the scripts
# (e.g. when using `pnpm engine:link` instead of the registry).
SKIP_NODE_AUTH_TOKEN_CHECK=
