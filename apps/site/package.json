{
  "name": "@beyours/site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node ../../scripts/infisical-bootstrap.mjs run --scope=site --optional -- next dev",
    "dev:plain": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "seed": "convex run saSeed:run",
    "seed:reset": "convex run saSeed:reset '{\"confirm\":true}'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-sesv2": "^3.1024.0",
    "@base-ui/react": "^1.3.0",
    "@calcom/embed-react": "^1.5.3",
    "@convex-dev/auth": "^0.0.95",
    "@number-flow/react": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/nextjs": "^10.71.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.44.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.6.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.9",
    "convex-test": "^0.0.44",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "shadcn": "^4.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
}
