# =============================================================================
# apps/site (@beyours/site) — environment template
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#   cp apps/site/.env.example apps/site/.env.local
#
# apps/site is the COMMERCIAL site (beyours.fr). It depends on none of the
# engine packages, so it does NOT follow the package/site split described in
# _project/ENVIRONMENT_VARIABLES.md — that split covers the restaurant apps
# (apps/reference, apps/themes). This app has its own surface.
#
# For the PRODUCTION values and the build-cache caveat, see
# .env.production.example — read it before any prod env change.
#
# ⚠️  NEXT_PUBLIC_* are inlined into the JS bundle at `next build`. After
#     changing one on Vercel, REBUILD WITHOUT CACHE — a plain redeploy reuses
#     the build cache and does NOT re-inline the new values.
# =============================================================================

# --- Convex ------------------------------------------------------------------
# Point these at YOUR dev deployment (`pnpx convex dev`), never at prod.
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud
# HTTP actions endpoint. Must stay paired with NEXT_PUBLIC_CONVEX_URL
# (same subdomain, .convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment.convex.site
# Server-side equivalent, used to build webhook / callback URLs.
CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# --- Auth (Convex Auth) — NE PAS remplir ici ---------------------------------
# `convex/auth.ts` utilise @convex-dev/auth (provider Password). Cette
# librairie exige DEUX variables sur le déploiement Convex :
#
#   JWT_PRIVATE_KEY   clé privée de signature des JWT de session
#   JWKS              le jeu de clés publiques correspondant
#
# Elles ne se mettent pas dans ce fichier et ne se saisissent pas à la main :
# `npx @convex-dev/auth` les génère et les pose directement sur le déploiement.
# Le serveur d'auth les lit ; AUCUN code de cette app ne les référence — ce qui
# veut dire qu'un `grep` ne les trouvera jamais et qu'elles ont tout l'air
# d'orphelines. Elles ne le sont pas.
#
# Sans elles : plus aucune session n'est signable, personne ne se connecte.
# Ne pas les supprimer en faisant le ménage des variables d'un déploiement.

# --- Site URLs ---------------------------------------------------------------
# Canonical public URL: absolute SEO links + logo in transactional emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Tax ---------------------------------------------------------------------
# The entity is on the régime réel (VAT.regime in lib/legal/company.ts), so both
# of these belong at true — they go together and both are checked against the
# regime, not against each other.
# Each is checked where it is visible, and that is not the same place:
#   NEXT_PUBLIC_TVA_ENABLED — Next side, so validateSiteEnv sees it. Refused
#     when it contradicts the regime AND when it is simply missing: it decides
#     the total the checkout prints and it is frozen into the bundle at build.
#   STRIPE_TAX_ENABLED — Convex side in production, invisible to validateSiteEnv.
#     Checked by createCheckoutSession, which refuses the sale rather than
#     invoice it wrongly; unset reads as "off", which is the fail-closed side.
# The checkout also carries the stance the client displayed and refuses a sale
# that would debit a total the customer was never shown.
# Requires Stripe Tax enabled on the account and tax_behavior=exclusive on the
# Prices (see convex/stripe.ts) — true in test mode too.
NEXT_PUBLIC_TVA_ENABLED=true
STRIPE_TAX_ENABLED=true

# --- Stripe (server-side only — NEVER expose as NEXT_PUBLIC_) ----------------
# In production these belong to the Convex deployment env, not the Vercel
# client bundle.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Runs checkout WITHOUT Stripe: nothing is charged, orders go straight to
# "paid", founders seats are consumed and confirmation emails go out. Leave it
# unset anywhere that sells. Without a Stripe key AND without this set to
# exactly "true", the money paths refuse instead of giving the product away.
BEYOURS_TEST_CHECKOUT=

# The four recurring maintenance Price IDs, one per plan/period pair.
# convex/stripe.ts THROWS when the one it needs is missing, and it throws
# mid-checkout: the customer is debited and never provisioned. There is no
# fallback on purpose — a TEST Price ID charged with a live key would fail the
# same way, later. Set all four or none.
# ⚠️  These live on the CONVEX deployment env (`npx convex env set …`), NOT on
#     Vercel. Filling them here only covers local dev.
STRIPE_PRICE_ESSENTIELLE_MONTHLY=
STRIPE_PRICE_ESSENTIELLE_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Founders offer — the coupon and the two persistent creation Products go
# TOGETHER. The coupon caps the offer (max_redemptions), and the Products are
# what it is restricted to (applies_to) so the discount lands entirely on the
# creation line instead of spreading pro rata over maintenance: right total,
# wrong split on the customer's invoice.
# With a live Stripe key and either one missing, a founders checkout is
# REFUSED rather than served free — without the cap, every site past the tenth
# ships for nothing. Also on the CONVEX deployment env.
STRIPE_FOUNDERS_COUPON_ID=
STRIPE_PRODUCT_CREATION_ESSENTIELLE=
STRIPE_PRODUCT_CREATION_PREMIUM=

# --- Email -------------------------------------------------------------------
# Selects the transactional email backend. Fill the matching block below.
EMAIL_PROVIDER=
EMAIL_FROM=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AWS SES
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# --- Contact / notifications -------------------------------------------------
# Public contact address surfaced on the marketing pages.
CONTACT_EMAIL=
# Alerted when a client requests a site migration.
BID_NOTIFY_EMAIL=
# Booking link put in the post-purchase emails. Points at the LANCEMENT event
# (the post-purchase kickoff), not the public discovery one. The site CTAs do
# not read this: they use the links in components/booking-modal.tsx.
#
# CALENDLY_URL is still read as a fallback so the deployed environments keep
# working until they are renamed. Set BOOKING_URL and drop the old one.
BOOKING_URL=https://bookself.app/beyours/lancement

# =============================================================================
# CI / tooling (not used at runtime)
# =============================================================================
# Base URL hit by the production smoke tests (scripts/check-prod-bundle.mjs).
LIVE_URL=
