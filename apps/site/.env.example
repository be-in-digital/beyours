# =============================================================================
# apps/site (@beyours/site) — environment template
# =============================================================================
# Copy to .env.local and fill in real values. NEVER commit .env.local.
#   cp apps/site/.env.example apps/site/.env.local
#
# apps/site is the COMMERCIAL site (beyours.fr). It depends on none of the
# engine packages, so it does NOT follow the package/site split described in
# _project/ENVIRONMENT_VARIABLES.md — that split covers the restaurant apps
# (apps/reference, apps/themes). This app has its own surface.
#
# For the PRODUCTION values and the build-cache caveat, see
# .env.production.example — read it before any prod env change.
#
# ⚠️  NEXT_PUBLIC_* are inlined into the JS bundle at `next build`. After
#     changing one on Vercel, REBUILD WITHOUT CACHE — a plain redeploy reuses
#     the build cache and does NOT re-inline the new values.
# =============================================================================

# --- Convex ------------------------------------------------------------------
# Point these at YOUR dev deployment (`pnpx convex dev`), never at prod.
NEXT_PUBLIC_CONVEX_URL=https://your-dev-deployment.convex.cloud
# HTTP actions endpoint. Must stay paired with NEXT_PUBLIC_CONVEX_URL
# (same subdomain, .convex.site).
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-dev-deployment.convex.site
# Server-side equivalent, used to build webhook / callback URLs.
CONVEX_SITE_URL=https://your-dev-deployment.convex.site

# --- Site URLs ---------------------------------------------------------------
# Canonical public URL: absolute SEO links + logo in transactional emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# --- Tax ---------------------------------------------------------------------
# Keep false while the entity is under franchise en base (art. 293 B CGI).
# On switching, set BOTH of these to true — they go together
# (cf. convex/stripe.ts & lib/payment-providers.ts). Absent ⇒ false.
NEXT_PUBLIC_TVA_ENABLED=false
STRIPE_TAX_ENABLED=false

# --- Stripe (server-side only — NEVER expose as NEXT_PUBLIC_) ----------------
# In production these belong to the Convex deployment env, not the Vercel
# client bundle.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email -------------------------------------------------------------------
# Selects the transactional email backend. Fill the matching block below.
EMAIL_PROVIDER=
EMAIL_FROM=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# AWS SES
AWS_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=

# --- Contact / notifications -------------------------------------------------
# Public contact address surfaced on the marketing pages.
CONTACT_EMAIL=
# Alerted when a client requests a site migration.
BID_NOTIFY_EMAIL=
# Booking link put in the post-purchase emails. Points at the LANCEMENT event
# (the post-purchase kickoff), not the public discovery one. The site CTAs do
# not read this: they use the URLs in components/calendly-modal.tsx.
CALENDLY_URL=https://bookself.app/beyours/lancement

# =============================================================================
# CI / tooling (not used at runtime)
# =============================================================================
# Base URL hit by the production smoke tests (scripts/check-prod-bundle.mjs).
LIVE_URL=
